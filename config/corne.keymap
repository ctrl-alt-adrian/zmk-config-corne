#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        HML: HML {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            hold-trigger-key-positions = <36 37 38 39 40 41 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35>;
            hold-trigger-on-release;
        };

        HMR: HMR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <38 37 36 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 39 40 41>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp ESCAPE      &kp Q                &kp W            &kp E            &kp R  &kp T         &kp Y      &kp U  &kp I             &kp O             &kp P                         &kp BSPC
&kp LEFT_SHIFT  &HML LEFT_CONTROL A  &HML LEFT_ALT S  &HML LEFT_WIN D  &kp F  &kp G         &kp H      &kp J  &HMR RIGHT_WIN K  &HMR RIGHT_ALT L  &HMR RIGHT_CONTROL SEMICOLON  &kp SQT
&kp BACKSLASH   &kp Z                &kp X            &kp C            &kp V  &kp B         &kp N      &kp M  &kp COMMA         &kp DOT           &kp FSLH                      &kp TAB
                                                      &kp LGUI         &mo 1  &kp RETURN    &kp SPACE  &mo 2  &kp RALT
            >;
        };

        lower {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  |   \  |
            // | CTRL|  1   | 2   | 3   | 4   |  5  |   | -   | =   |  `  |  [  |  ]  |  |   |
            // | LSHFT| 6   | 7   |  8  | 9   |  0  |   | _   |  +  |  ~  |  {  |  }  |  LEFT_ALT  |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp KP_MULTIPLY  &kp MINUS      &mt AMPS N7          &mt ASTRK N8     &mt LEFT_PARENTHESIS N9  &kp PLUS      &kp INSERT  &kp PAGE_UP    &kp PRINTSCREEN  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &mt TILDE GRAVE
&kp SLASH        &kp BACKSPACE  &mt DOLLAR NUMBER_4  &mt PERCENT N5   &mt CARET NUMBER_6       &kp RETURN    &kp HOME    &kp PAGE_DOWN  &kp SCROLLLOCK   &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp DOLLAR
&kp BACKSLASH    &kp N0         &mt EXCL NUMBER_1    &mt AT NUMBER_2  &mt HASH NUMBER_3        &kp PERIOD    &kp DELETE  &kp END        &kp PAUSE_BREAK  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp LEFT_ALT
                                                     &kp LGUI         &trans                   &kp RET       &kp SPACE   &trans         &kp RALT
            >;
        };

        raise {
            // -----------------------------------------------------------------------------------------
            // |     | F1 | F2 | F3 | F4 | F5 | | F6      | F7       | F8       | F9       | F10      | F11 |
            // |     | Prv| Nxt| VDn| VUp| Ply| | LEFT    | DOWN     | UP       | RIGHT    | OUT_USB  | F12 |
            // |BTCLR| BT0| BT1| BT2| BT3| BT4| | OUT_BLE | OUT_TOG  |           |          |          |     |
            // | GUI |    | RET| SPC|    | ALT |

            bindings = <
&kp CAPS    &kp F1        &kp F2        &kp F3        &kp F4        &kp F5              &kp F6        &kp F7        &kp F8    &kp F9              &kp F10               &kp F11
&kp C_MUTE  &kp C_PREV    &kp C_NEXT    &kp C_VOL_DN  &kp C_VOL_UP  &kp C_PLAY_PAUSE    &kp LEFT      &kp DOWN      &kp UP    &kp RIGHT           &out OUT_USB          &kp F12
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4        &out OUT_BLE  &out OUT_TOG  &none     &kp K_CONTEXT_MENU  &kp C_AL_TEXT_EDITOR  &kp C_AL_CALCULATOR
                                        &kp LGUI      &trans        &kp RET             &kp SPACE     &trans        &kp RALT
            >;
        };
    };
};
